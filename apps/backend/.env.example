PORT=3001

# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/runmate_crm

# Random long secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long an issued JWT stays valid (fastify/jwt / ms library format)
JWT_EXPIRES_IN=8h

# AES-256-GCM key for encrypting stored IMAP/SMTP passwords at rest.
# Must be exactly 32 bytes, hex-encoded (64 hex characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this key after accounts exist makes stored passwords undecryptable.
EMAIL_ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# Google Gemini API key (free tier), used to auto-fill lead fields from
# uploaded photos (business cards, screenshots). Get one at
# https://aistudio.google.com/apikey.
# Leave empty to disable the "AI kitöltés" feature on the Leads form.
GEMINI_API_KEY=
