{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RunMate CRM",
  "version": "0.1.74",
  "identifier": "com.runmate.crm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RunMate CRM",
        "width": 1000,
        "height": 700,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1RjFCOTcyRkMxMzhDMzUKUldRMWpCUDhjcm54eFYraUdCdDFuTGIwZHVJRHJmWVJVVDJWZEZuak8ySVNzV3I4N2h1VWtTTjgK",
      "endpoints": [
        "https://github.com/runmatecompany/runmate-crm/releases/latest/download/latest.json"
      ]
    }
  }
}
